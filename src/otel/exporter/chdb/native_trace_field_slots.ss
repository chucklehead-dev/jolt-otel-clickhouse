;; Bounded default-policy collection directly into confirmed field ordinals.
;; Schema tables are immutable after construction; all input/output scratch is
;; invocation-owned. Unsupported shapes decline BEFORE invoking user callbacks.
(let ((string-var (jolt-var "clojure.core" "string?"))
      (attributes-key (keyword #f "attributes"))
      (resource-key (keyword #f "resource"))
      (scope-key (keyword #f "scope"))
      (span-location (keyword #f "span-attributes"))
      (resource-location (keyword #f "resource-attributes"))
      (scope-location (keyword #f "scope-attributes")))
  (define (return-pair value status) (values value status))
  (define (collect-entry! key value context)
    (when (vector-ref context 2)
      (if (not (string? key))
          (vector-set! context 2 #f)
          (let ((index (hashtable-ref (vector-ref context 1) key #f)))
            (when index (vector-set! (vector-ref context 0) index value)))))
    context)
  (lambda (locations plan key-var contains-var original-key project-var original-projector)
    ;; Match the existing positional emitter's capability fence. Reject a
    ;; missing bridge at construction, not after invoking a classifier.
    (when original-projector
      (unless (and (top-level-bound? 'jolt-invoke3)
                   (procedure? (top-level-value 'jolt-invoke3))
                   (bitwise-bit-set? (procedure-arity-mask (top-level-value 'jolt-invoke3)) 4))
        (error 'native-projection "Runtime continuation bridge is unavailable")))
    (and (pvec? locations) (pvec? plan) original-key
         (<= 1 (pvec-cnt locations) 3) (<= 1 (pvec-cnt plan) 8)
         (let* ((location-count (pvec-cnt locations)) (n (pvec-cnt plan))
                (kinds (make-vector location-count))
                (indices (make-vector location-count))
                (fields (make-vector n))
                (absent (cons #f #f)) (schema-valid? #t))
           (define (current?)
             (and (eq? (var-cell-deref key-var) original-key)
                  (eq? (var-cell-deref contains-var) jolt-contains?)
                  (eq? (var-cell-deref string-var) jolt-string?)))
           (define (attributes-at span kind)
             (let ((parent (case kind ((0) span) ((1) (jolt-get span resource-key))
                                 (else (jolt-get span scope-key)))))
               (cond ((jolt-nil? parent) empty-pmap)
                     ((pmap? parent)
                      (let ((attributes (jolt-get parent attributes-key)))
                        (if (or (jolt-nil? attributes) (eq? attributes #f)) empty-pmap attributes)))
                     (else absent))))
           (do ((i 0 (+ i 1))) ((= i location-count))
             (let ((location (pvec-nth! locations i)))
               (vector-set! kinds i
                 (cond ((eq? location span-location) 0)
                       ((eq? location resource-location) 1)
                       ((eq? location scope-location) 2)
                       (else (set! schema-valid? #f) 0)))
               (vector-set! indices i (make-hashtable string-hash string=?))))
           (do ((i 0 (+ i 1))) ((= i n))
             (let ((field (pvec-nth! plan i)))
               (if (not (and (pvec? field) (= (pvec-cnt field) 3)))
                   (set! schema-valid? #f)
                   (let ((location (pvec-nth! field 0))
                         (key (pvec-nth! field 1)) (type (pvec-nth! field 2)))
                     (if (not (and (fixnum? location) (<= 0 location) (< location location-count) (string? key)))
                         (set! schema-valid? #f)
                         (let ((table (vector-ref indices location)))
                           ;; Duplicate schema keys may have distinct field
                           ;; interpretations. Keep them on the original path.
                           (when (hashtable-ref table key #f) (set! schema-valid? #f))
                           (hashtable-set! table key i)
                           (vector-set! fields i (vector location key type))))))))
           (and schema-valid?
                (lambda (span)
                  (and (pmap? span) (current?)
                       (let ((attributes (make-vector location-count)) (valid? #t))
                         ;; All shape admission precedes any scan/callback.
                         (do ((i 0 (+ i 1))) ((= i location-count))
                           (let ((m (attributes-at span (vector-ref kinds i))))
                             (if (and (pmap? m) (<= (pmap-cnt m) 128))
                                 (vector-set! attributes i m)
                                 (set! valid? #f))))
                         (and valid?
                              (let* ((slots (make-vector n absent))
                                     (context (vector slots #f #t)))
                                (do ((i 0 (+ i 1))) ((= i location-count))
                                  (vector-set! context 1 (vector-ref indices i))
                                  (pmap-fold-seq-order (vector-ref attributes i) collect-entry! context))
                                (and (vector-ref context 2) (current?)
                                     (let ((out (make-vector (* n 2))))
                                       (do ((i 0 (+ i 1))) ((= i n) (make-pvec out))
                                         (let* ((raw (vector-ref slots i))
                                                (inputs (if (eq? raw absent) empty-pvec (make-pvec (vector raw))))
                                                ;; Read after input selection,
                                                ;; preserving the old boundary.
                                                (projector (var-cell-deref project-var))
                                                (type (vector-ref (vector-ref fields i) 2))
                                                (offset (* i 2)))
                                           (if (and original-projector (eq? projector original-projector))
                                               (let-values (((value status)
                                                             (jolt-invoke3 projector type inputs return-pair)))
                                                 (vector-set! out offset value)
                                                 (vector-set! out (+ offset 1) status))
                                               (let ((pair (jolt-invoke2 projector type inputs)))
                                                 (vector-set! out offset (jolt-nth pair 0 jolt-nil))
                                                 (vector-set! out (+ offset 1) (jolt-nth pair 1 jolt-nil))))))))))))))))))
