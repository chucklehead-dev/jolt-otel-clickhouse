; Guarded private cursor advances. See README for live source mapping.
(declare-const machine_max Int)
(declare-const kind Int)
(declare-const n Int)
(declare-const i Int)
(declare-const capacity Int)
(declare-const cursor Int)
(declare-const input_guard_enabled Bool)
(declare-const next_i Int)
(declare-const next_cursor Int)
(declare-const violation Bool)
(assert (! (or (= machine_max 536870911) (= machine_max 1152921504606846975)) :named supported_fixnum_max))
(assert (! (and (<= 0 kind) (<= kind 2)) :named operation_kind))
(assert (! (and (<= 0 n) (<= n machine_max) (<= 0 i) (<= i n)) :named input_loop_domain))
(assert (! (and (<= 0 capacity) (<= capacity 65536) (<= 0 cursor) (<= cursor capacity)) :named private_buffer_domain))
; kind0 clean input/output, kind1 byte! output only, kind2 escaped input only.
(assert (! (=> (not (= kind 1)) (or (not input_guard_enabled) (< i n))) :named input_body_guard))
(assert (! (=> (not (= kind 2)) (< cursor capacity)) :named output_body_guard))
(assert (! (= next_i (ite (= kind 1) i (+ i 1))) :named guarded_input_advance))
(assert (! (= next_cursor (ite (= kind 2) cursor (+ cursor 1))) :named guarded_output_advance))
; Equal-to-length positions are valid loop ends, never unguarded accesses.
(assert (! (= violation (or (< next_i 0) (> next_i machine_max) (> next_i n)
                            (< next_cursor 0) (> next_cursor machine_max) (> next_cursor capacity)))
           :named derived_violation))
(assert (! input_guard_enabled :named current_input_guard))
(assert (! violation :named counterexample))
