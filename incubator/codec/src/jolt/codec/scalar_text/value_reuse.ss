;; Output strategy for the EXISTING admitted scalar-text planner. No second
;; source traversal, no new shape/policy bypass, no duplicate planner. Templates
;; are private ordinal geometry; each raw values vector is fresh and immutable
;; after the planner calls this box. Retain only one first value per template,
;; <=8 entries /16384 charged key+value characters across the serial payload.
(lambda (original-box map-fold)
  (let ((entries (make-vector 8)) (used 0) (charged 0) (hits 0) (materialized 0))
    (define (text v)
      (cond ((string? v) v) ((eq? v #t) "true") ((eq? v #f) "false")
            (else (jolt-fixnum->string v))))
    (define (copy-coll pairs values)
      (if (null? pairs) '()
          (cons (cons (caar pairs) (text (vector-ref values (cdar pairs))))
                (copy-coll (cdr pairs) values))))
    (define (copy-node node values)
      (let* ((arr (hnode-arr node)) (size (vector-length arr)) (out (make-vector size)))
        (do ((i 0 (+ i 1))) ((= i size))
          (let ((child (vector-ref arr i)))
            (vector-set! out i
              (cond ((hnode? child) (copy-node child values))
                    ((hcoll? child) (make-hcoll (hcoll-hash child) (copy-coll (hcoll-alist child) values)))
                    (else (cons (car child) (text (vector-ref values (cdr child)))))))))
        (make-hnode (hnode-bm node) out)))
    (define (materialize-root template values)
      (let ((root (pmap-root template)))
        (if (hnode? root) (copy-node root values)
            (let* ((size (vector-length root)) (out (make-vector size)))
              (do ((i 0 (+ i 2))) ((= i size))
                (vector-set! out i (vector-ref root i))
                (vector-set! out (+ i 1) (text (vector-ref values (vector-ref root (+ i 1))))))
              out))))
    (define (same-values? a b)
      (let loop ((i 0))
        (or (= i (vector-length a))
            (let ((x (vector-ref a i)) (y (vector-ref b i)))
              (and (or (eq? x y) (and (string? x) (string? y) (string=? x y)))
                   (loop (+ i 1)))))))
    (define (charge template values)
      (map-fold template
        (lambda (key ordinal sum)
          (let ((v (vector-ref values ordinal)))
            (+ sum (string-length key)
               (cond ((string? v) (string-length v)) ((boolean? v) 5) (else 20))))) 0))
    (define (box template values)
      (let loop ((i 0))
        (if (= i used)
            (begin
              (when (< used 8)
                (let ((cost (charge template values)))
                  (when (<= (+ charged cost) 16384)
                    (vector-set! entries used (vector template values #f))
                    (set! used (+ used 1)) (set! charged (+ charged cost)))))
              (original-box template values))
            (let ((entry (vector-ref entries i)))
              (if (eq? template (vector-ref entry 0))
                  (if (same-values? values (vector-ref entry 1))
                      (begin
                        (set! hits (+ hits 1))
                        (unless (vector-ref entry 2)
                          ;; Equal-but-distinct caller Strings must not add a
                          ;; second retained copy under the first-slot charge.
                          (vector-set! entry 2 (materialize-root template (vector-ref entry 1)))
                          (set! materialized (+ materialized 1)))
                        (make-pmap (vector-ref entry 2) (vector-length values)))
                      (original-box template values))
                  (loop (+ i 1)))))))
    (jolt-vector box (lambda () (jolt-vector used charged hits materialized)))))
