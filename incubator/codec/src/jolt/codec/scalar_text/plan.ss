;; Experimental fixed-key projection. No SDK/global registration or input cache.
;; The owner supplies its original policy anchors, not current caller snapshots.
;; Build hash geometry from static keys once, then clone it with fresh values.
;; Private layout qualification belongs at this one boundary, on stock 0.8.23.
(lambda (view-box)
 (begin
  (unless (and
    (eq? (record-type-uid (record-type-descriptor pmap)) 'chez-pmap-v6)
    (equal? (record-type-field-names (record-type-descriptor pmap)) '#(root cnt hasheq meta))
    (eq? (record-type-uid (record-type-descriptor hnode)) 'chez-hnode-v1)
    (equal? (record-type-field-names (record-type-descriptor hnode)) '#(bm arr))
    (eq? (record-type-uid (record-type-descriptor hcoll)) 'chez-hcoll-v1)
    (equal? (record-type-field-names (record-type-descriptor hcoll)) '#(hash alist))
    (eq? (record-type-uid (record-type-descriptor htable)) 'chez-htable-v2)
    (eq? (record-type-uid (record-type-descriptor pvec)) 'chez-pvec-v4)
    (>= (most-negative-fixnum) -9223372036854775808)
    (<= (most-positive-fixnum) 9223372036854775807))
    (error 'fixed-shape "Unsupported runtime layout"))
  (lambda (bindings maximum prototype keys . kind)
    (unless (and (pvec? keys) (<= 0 (pvec-count keys) 128)
                 (fixnum? maximum) (<= 0 maximum)
                 (htable-sorted-map? prototype))
      (error 'fixed-shape "Invalid plan"))
    (let* ((hamt? (and (pair? kind) (eq? (car kind) 'hamt)))
           (n (pvec-count keys)) (ordered (make-vector n))
           (builder (jolt-transient-new empty-pmap))
           (stock-ops (jolt-ref-get prototype kw-ops))
           (anchors (make-vector (* 2 (pvec-count bindings)))))
      (define (current?)
        (let loop ((i 0))
          (or (= i (vector-length anchors))
              (and (eq? (var-cell-deref (vector-ref anchors i))
                        (vector-ref anchors (+ i 1)))
                   (loop (+ i 2))))))
      (define (text value)
        (cond (view-box value) ((string? value) value) ((eq? value #t) "true")
              ((eq? value #f) "false") (else (jolt-fixnum->string value))))
      (define (fill! tree values)
        (let ((seen 0) (ordinal 0))
          (define (walk node)
            (or (jolt-nil? node)
                (and (pvec? node) (= (pvec-count node) 5) (< seen n)
                     ;; Bound malformed/cyclic graphs before following children.
                     (begin (set! seen (+ seen 1)) #t)
                     (walk (sc-nd-left node))
                     (< ordinal n)
                     (let ((key (sc-nd-key node)) (value (sc-nd-val node)))
                       (and (string? key) (string=? key (vector-ref ordered ordinal))
                            (or (boolean? value) (fixnum? value)
                                (and (string? value) (<= (string-length value) maximum)))
                            (begin (vector-set! values ordinal (text value))
                                   (set! ordinal (+ ordinal 1)) #t)))
                     (walk (sc-nd-right node)))))
          (and (walk tree) (= seen n) (= ordinal n))))
      ;; Zip against the finite, privately constructed key/ordinal template.
      ;; Its geometry bounds recursion even for malformed source graphs.
      ;; Collision nodes deliberately decline, matching the original SDK HAMT
      ;; converter's admission; do not turn a new encoder into broader policy.
      (define (fill-hamt! node template values)
        (and (hnode? node) (hnode? template)
             (eqv? (hnode-bm node) (hnode-bm template))
             (let ((a (hnode-arr node)) (b (hnode-arr template)))
               (and (vector? a) (= (vector-length a) (vector-length b))
                    (let loop ((i 0))
                      (or (= i (vector-length b))
                          (let ((actual (vector-ref a i)) (expected (vector-ref b i)))
                            (and
                              (if (hnode? expected)
                                  (fill-hamt! actual expected values)
                                  (and (pair? expected) (pair? actual)
                                       (string? (car actual))
                                       (string=? (car actual) (car expected))
                                       (let ((value (cdr actual)))
                                         (and (or (boolean? value) (fixnum? value)
                                                  (and (string? value)
                                                       (<= (string-length value) maximum)))
                                              (begin (vector-set! values (cdr expected) value) #t)))))
                              (loop (+ i 1))))))))))
      (define (copy-coll pairs values)
        (if (null? pairs) '()
            (cons (cons (caar pairs) (vector-ref values (cdar pairs)))
                  (copy-coll (cdr pairs) values))))
      (define (copy-node node values)
        (let* ((arr (hnode-arr node)) (size (vector-length arr))
               (out (make-vector size)))
          (do ((i 0 (+ i 1))) ((= i size))
            (let ((child (vector-ref arr i)))
              (vector-set! out i
                (cond ((hnode? child) (copy-node child values))
                      ((hcoll? child)
                       (make-hcoll (hcoll-hash child) (copy-coll (hcoll-alist child) values)))
                      (else (cons (car child) (vector-ref values (cdr child))))))))
          (make-hnode (hnode-bm node) out)))
      ;; The template retains schema keys/ordinal indexes, never source values.
      (when (and hamt? (not view-box))
        (error 'fixed-shape "HAMT plans require the encoder-only view owner"))
      (do ((i 0 (+ i 1))) ((= i n))
        (let ((key (pvec-nth! keys i)))
          (unless (string? key) (error 'fixed-shape "Expected string schema key"))
          (vector-set! ordered i key)
          (tmap-put! builder key i)))
      (do ((i 0 (+ i 1))) ((= i (pvec-count bindings)))
        (let ((entry (pvec-nth! bindings i)))
          (vector-set! anchors (* 2 i) (pvec-nth! entry 0))
          (vector-set! anchors (+ (* 2 i) 1) (pvec-nth! entry 1))))
      (let ((template (jolt-persistent! builder)))
        (unless (= n (pmap-cnt template)) (error 'fixed-shape "Duplicate schema keys"))
        (let ((root (pmap-root template)))
          (lambda (m)
            (and (if hamt?
                     (and (pmap? m) (> n 8) (eqv? (pmap-cnt m) n))
                     (and (htable-sorted-map? m) (eq? (jolt-ref-get m kw-ops) stock-ops)
                          (eqv? (jolt-ref-get m kw-cnt) n)))
                 (current?)
                 (let ((values (make-vector n)))
                   (and (if hamt? (fill-hamt! (pmap-root m) root values)
                                  (fill! (jolt-ref-get m kw-tree) values))
                        (current?)
                        (if view-box (view-box template values)
                         (if (hnode? root)
                            (make-pmap (copy-node root values) n)
                            (let* ((size (vector-length root)) (out (make-vector size)))
                              (do ((i 0 (+ i 2))) ((= i size))
                                (vector-set! out i (vector-ref root i))
                                (vector-set! out (+ i 1)
                                  (vector-ref values (vector-ref root (+ i 1)))))
                              (make-pmap out n))))))))))))))
