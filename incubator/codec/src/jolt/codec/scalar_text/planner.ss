;; `compile-one` is the lexical fixed-key kernel, not a runtime-global helper.
;; State belongs to one synchronous payload owner. Retain only bounded key
;; schemas and compiled geometry: never input wrappers/trees or telemetry values.
(lambda (bindings maximum prototype max-plans max-key-chars)
  (unless (and (fixnum? max-plans) (<= 0 max-plans 8)
               (fixnum? max-key-chars) (<= 0 max-key-chars 8192)
               (fixnum? maximum) (<= 0 maximum)
               (htable-sorted-map? prototype))
    (error 'scalar-text-planner "Invalid bounded planner configuration"))
  (let ((plans (make-vector max-plans)) (used 0) (key-chars 0)
        (stock-ops (jolt-ref-get prototype kw-ops))
        (stock-rtd (record-rtd prototype))
        (native-nodes? (eq? (record-type-uid (record-rtd prototype)) 'chez-scoll-v1)))
    (define (node? node)
      (if native-nodes?
          (and (vector? node) (= (vector-length node) 5) (boolean? (vector-ref node 0)))
          (and (pvec? node) (= (pvec-count node) 5))))
    (define (lookup m)
      (let loop ((i 0))
        (and (< i used)
             (or ((vector-ref plans i) m) (loop (+ i 1))))))
    (define (collect-keys m remaining)
      (and (htable-sorted-map? m) (eq? (record-rtd m) stock-rtd)
           (eq? (jolt-ref-get m kw-ops) stock-ops)
           (let ((n (jolt-ref-get m kw-cnt)))
             (and (fixnum? n) (<= 0 n 128)
                  (let ((keys (make-vector n)) (seen 0) (i 0) (chars 0)
                        (unique (make-hashtable string-hash string=?)))
                    (define (walk node)
                      (or (jolt-nil? node)
                          (and (node? node) (< seen n)
                               (begin (set! seen (+ seen 1)) #t)
                               (walk (sc-nd-left node)) (< i n)
                               (let ((key (sc-nd-key node)))
                                 (and (string? key)
                                      (not (hashtable-contains? unique key))
                                      (<= (+ chars (string-length key)) remaining)
                                      (begin
                                        (set! chars (+ chars (string-length key)))
                                        (hashtable-set! unique key #t)
                                        (vector-set! keys i key)
                                        (set! i (+ i 1)) #t)))
                               (walk (sc-nd-right node)))))
                    (and (walk (jolt-ref-get m kw-tree)) (= seen n) (= i n)
                         (cons (apply jolt-vector (vector->list keys)) chars)))))))
    (define (learn! m)
      (and (< used max-plans)
           (let ((collected (collect-keys m (- max-key-chars key-chars))))
             (and collected
                  (let ((plan (compile-one bindings maximum prototype (car collected))))
                    ;; Independently enforce values and both live policy checks;
                    ;; the owner's previous admission is not a permission token.
                    (and (plan m)
                         (begin (vector-set! plans used plan)
                                (set! used (+ used 1))
                                (set! key-chars (+ key-chars (cdr collected))) #t)))))))
    (lambda (op m)
      (case op ((0) (lookup m)) ((1) (learn! m))
            ((2) (jolt-vector used key-chars))
            (else (error 'scalar-text-planner "Unknown operation"))))))
