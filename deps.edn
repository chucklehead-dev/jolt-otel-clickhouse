              :deps/root "incubator/codec"}}}
           :scalar-views-test
           {:extra-paths ["incubator/codec/src" "incubator/codec/test"]
            :extra-deps
            {io.github.casselc/otel
             {:git/url "https://github.com/casselc/otel.git"
              :git/sha "6cd57c86e0a93fc56af6cb10ee433b178b289e3b"
              :exclusions [jolt-lang/jolt-crypto]}}
            :main-opts ["-m" "otel.exporter.chdb-scalar-views-test"]}
           :stock-span-codec-test
           {:extra-paths ["incubator/codec/test"]
            :main-opts ["-m" "otel.exporter.chdb-stock-published-codec-test"]}
           :stock-shape-plans-test
