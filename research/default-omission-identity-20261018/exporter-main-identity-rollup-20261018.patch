+++ b/test/otel/exporter/chdb_sdk_sorted_scalar_map_test.clj
@@ -0,0 +1,68 @@
+(ns otel.exporter.chdb-sdk-sorted-scalar-map-test
+  (:require [clojure.test :refer [deftest is run-tests]]
+            [otel.any-value :as any] [otel.exporter.chdb :as e]
+            [otel.exporter.chdb-sdk-scalar-map-test :refer [fixture oracle convert]]
+            [jolt.host :as host]))
+
+(defn sorted-fixture [n] (into (sorted-map) (fixture n)))
+
+(deftest source-owned-sorted-path-precedes-native-and-generic-fallbacks
+  (let [m (with-meta (sorted-fixture 16) {:source true}) expected (oracle m)]
+    (with-redefs [e/small-attribute-transform
+                  (delay (fn [_] (throw (ex-info "must-not-fallback" {}))))]
+      (let [actual (convert m)]
+        (is (= expected actual))
+        (is (= (type expected) (type actual)))
+        (is (= (vec expected) (vec actual)))
+        (is (nil? (meta actual)))
+        (is (= {:source true} (meta m)))))))
+
+(deftest unsupported-inputs-and-missing-helper-retain-normal-conversion
+  (doseq [m [(sorted-fixture 129) (assoc (sorted-fixture 16) "nil" nil)
+             (assoc (sorted-fixture 16) "float" 1.25)
+             (assoc (sorted-fixture 16) "nested" [1 false])
+             (sorted-map :alias 42) (assoc (sorted-fixture 9) "Aa" 1 "BB" 2)]]
+    (is (= (vec (oracle m)) (vec (convert m)))))
+  (with-redefs [e/sdk-sorted-scalar-map-converter (delay nil)]
+    (is (= (oracle (sorted-fixture 16)) (convert (sorted-fixture 16))))))
+
+(deftest custom-operations-are-not-tried-before-fallback
+  (let [m (sorted-fixture 16) calls (atom 0)
+        entries (vec m) ops (host/ref-get m :ops)]
+    (host/ref-put! m :ops (assoc ops :seq (fn [_] (swap! calls inc) (seq entries))))
+    (is (= (into {} (map (fn [[k v]] [k (any/try-scalar-string v)])) entries) (convert m)))
+    (is (= 1 @calls))))
+
+(deftest changed-exporter-and-sdk-policies-remain-live
+  (let [m (sorted-fixture 16) seen (atom [])]
+    (with-redefs [e/value-string (fn [v] (swap! seen conj v) "changed")]
+      (is (= (zipmap (keys m) (repeat "changed")) (convert m)))
+      (is (= (vec (vals m)) @seen)))
+    (reset! seen [])
+    (with-redefs [any/try-scalar-string (fn [v] (swap! seen conj v) "sdk-change")]
+      (is (= (zipmap (keys m) (repeat "sdk-change")) (convert m)))
+      (is (= (vec (vals m)) @seen)))
+    (with-redefs [e/key-string (fn [k] (str "new-" k))]
+      (is (= (oracle m) (convert m))))))
+
+(deftest late-policy-change-does-not-call-a-second-sdk-helper-or-accept-result
+  (let [m (sorted-fixture 16) sdk-var (ns-resolve 'otel.any-value 'try-sorted-scalar-string-map)
+        actual @sdk-var original @#'e/value-string seen (atom [])]
+    (with-redefs-fn
+      {#'e/value-string original
+       #'any/try-scalar-string-map (fn [_] (throw (ex-info "second-helper-must-not-run" {})))
+       sdk-var (fn [value]
+                 (let [result (actual value)]
+                   (alter-var-root #'e/value-string
+                                   (constantly (fn [v] (swap! seen conj v) "late")))
+                   result))}
+      #(do (is (= (zipmap (keys m) (repeat "late")) (convert m)))
+           (is (= (vec (vals m)) @seen))))))
+
+(defn -main [& _]
+  (let [sdk-var (ns-resolve 'otel.any-value 'try-sorted-scalar-string-map)]
+    (assert (and sdk-var (some? (@sdk-var (sorted-fixture 16))))
+            "strict gate requires the new SDK sorted-map capability"))
+  (let [r (run-tests 'otel.exporter.chdb-sdk-sorted-scalar-map-test)]
+    (assert (= 5 (:test r)))
+    (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))
diff --git a/test/otel/exporter/chdb_sorted_event_encoding_test.clj b/test/otel/exporter/chdb_sorted_event_encoding_test.clj
new file mode 100644
index 0000000..3a1bd12
--- /dev/null
+++ b/test/otel/exporter/chdb_sorted_event_encoding_test.clj
@@ -0,0 +1,65 @@
+(ns otel.exporter.chdb-sorted-event-encoding-test
+  (:require [clojure.test :refer [deftest is run-tests]]
+            [clojure.string :as str]
+            [clojure.data.json :as json]
+            [clojure.data.json.jolt-native :as native]
+            [otel.exporter.chdb :as e]
+            [otel.sdk.tracer :as sdk] [otel.sdk.export :as export]
+            [otel.exporter.memory :as memory] [otel.resource :as resource]
+            [otel.trace :as trace]))
+
+(defn ended-spans []
+  (let [attrs (into {"service.name" "sorted-event-test" "flag" false "count" 42}
+                    (map (fn [i] [(str "extra-" i)
+                                  (case (mod i 3) 0 "λ\n\"😀" 1 false i)]) (range 14)))
+        sink (memory/exporter)
+        provider (sdk/tracer-provider {:resource (resource/resource attrs)
+                                       :processors [(export/simple-processor sink)]})
+        tracer (sdk/get-tracer provider {:name "sorted-event-test" :attributes attrs})]
+    (try
+      (dotimes [i 2]
+        (trace/with-span [span tracer (str "scenario-" i) {:attributes attrs}]
+          (trace/add-event! span "event" attrs)))
+      (finally (assert (sdk/shutdown! provider))))
+    (memory/spans sink)))
+
+(defn stock-payload [spans compact?]
+  (with-bindings {#'e/*json-backend* :configured #'e/*timestamp-wire* :raw-ticks}
+    (apply str (map #(str (json/write-str (@#'e/span-row % nil compact?)) "\n") spans))))
+
+(defn native-payload [spans compact? prefix budget]
+  (with-bindings {#'e/*json-backend* :native-guarded-byte-batch #'e/*timestamp-wire* :raw-ticks}
+    (native/write-prefixed-batch-bytes!
+      prefix (map #(@#'e/span-row % nil compact?) spans) budget)))
+
+(deftest actual-sdk-sorted-events-have-identical-named-and-compact-bytes
+  (let [spans (ended-spans)]
+    (is (= 2 (count spans)))
+    (is (every? #(sorted? (get-in % [:resource :attributes])) spans))
+    (is (every? #(sorted? (get-in % [:events 0 :attributes])) spans))
+    (doseq [compact? [false true]]
+      (let [expected (stock-payload spans compact?)
+            actual (String. (native-payload spans compact? "" 100000) "UTF-8")]
+        (is (= expected actual))
+        (is (= 2 (count (str/split-lines actual))))))
+    (let [row (json/read-str (first (str/split-lines
+                                    (String. (native-payload spans false "" 100000) "UTF-8"))))
+          event (first (json/read-str (get row "EventsJSON")))]
+      (is (false? (get-in event ["attributes" "flag"])))
+      (is (= 42 (get-in event ["attributes" "count"])))
+      (is (= "λ\n\"😀" (get-in event ["attributes" "extra-0"]))))))
+
+(deftest event-rich-output-honors-exact-newline-inclusive-byte-limit
+  (let [spans (ended-spans) prefix "prefix-not-in-budget "
+        expected (stock-payload spans true)
+        budget (alength (.getBytes expected "UTF-8"))]
+    (is (= (str prefix expected)
+           (String. (native-payload spans true prefix budget) "UTF-8")))
+    (is (= ::native/output-limit
+           (:type (ex-data (try (native-payload spans true prefix (dec budget))
+                               nil (catch Throwable error error))))))))
+
+(defn -main [& _]
+  (let [r (run-tests 'otel.exporter.chdb-sorted-event-encoding-test)]
+    (assert (and (= 2 (:test r)) (>= (:pass r) 12)))
+    (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))
