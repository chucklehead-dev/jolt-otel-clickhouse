;; Diagnostic only. Counters are scalar aggregates, never per-value records.
;; statistics allocation/time includes observer cost; calibrate explicitly.
(lambda ()
  (let ((totals (make-vector 25 0)))
    (define (nanos time)
      (+ (* 1000000000 (time-second time)) (time-nanosecond time)))
    (define (add! index amount)
      (vector-set! totals index (+ (vector-ref totals index) amount)))
    (jolt-vector
     (lambda (phase operation)
       (unless (and (fixnum? phase) (<= 0 phase 4) (procedure? operation))
         (error 'row-costs "invalid observer"))
       (let ((offset (* phase 5)))
         (lambda (value)
           (let* ((before (statistics))
                  (result (jolt-invoke1 operation value))
                  (after (statistics)))
             (add! offset 1)
             (add! (+ offset 1) (- (nanos (sstats-real after)) (nanos (sstats-real before))))
             (add! (+ offset 2) (- (sstats-bytes after) (sstats-bytes before)))
             (add! (+ offset 3) (- (nanos (sstats-cpu after)) (nanos (sstats-cpu before))))
             (add! (+ offset 4) (- (nanos (sstats-gc-real after)) (nanos (sstats-gc-real before))))
             result))))
     (lambda () (vector-fill! totals 0))
     (lambda ()
       (jolt-vector
        (jolt-vector (vector-ref totals 0) (vector-ref totals 1) (vector-ref totals 2) (vector-ref totals 3) (vector-ref totals 4))
        (jolt-vector (vector-ref totals 5) (vector-ref totals 6) (vector-ref totals 7) (vector-ref totals 8) (vector-ref totals 9))
        (jolt-vector (vector-ref totals 10) (vector-ref totals 11) (vector-ref totals 12) (vector-ref totals 13) (vector-ref totals 14))
        (jolt-vector (vector-ref totals 15) (vector-ref totals 16) (vector-ref totals 17) (vector-ref totals 18) (vector-ref totals 19))
        (jolt-vector (vector-ref totals 20) (vector-ref totals 21) (vector-ref totals 22) (vector-ref totals 23) (vector-ref totals 24)))))))
