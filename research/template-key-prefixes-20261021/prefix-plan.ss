;; Encoder-local weak template roots. Plans retain only byte copies/ordinals.
;; Eight attempts including declines, <=32KiB/plan and128KiB total prefixes;
;; <=128 fields and64scalar characters/key. These are not an RSS bound.
(define (prefix-key? key)
  (and (string? key) (fx<=? (string-length key) 64)
       (let loop ((i 0))
         (or (fx=? i (string-length key))
             (let ((cp (char->integer (string-ref key i))))
               (and (not (and (fx>=? cp #xd800) (fx<=? cp #xdfff)))
                    (loop (fx+ i 1))))))))
(define (compile-prefix-plan template)
  (let* ((n (pmap-cnt template)) (ordinals (make-vector n))
         (prefixes (make-vector n)) (i 0) (charge 0) (valid? #t))
    (ffc-map-fold template
      (lambda (key ordinal ignored)
        (when valid?
          (if (not (and (prefix-key? key) (fixnum? ordinal) (fx<=? 0 ordinal) (fx<? ordinal n)))
              (set! valid? #f)
              (let* ((encoded (jolt-array-vec
                               (ffc-prefix-key-encode key 1024 0 #f escape-unicode? #f "")))
                     (length (bytevector-length encoded))
                     (comma (if (fx=? i 0) 0 1))
                     (size (fx+ length comma 1)))
                (set! charge (fx+ charge size))
                (if (or (fx>? charge 32768) (fx>? charge (fx- 131072 template-bytes)))
                    (set! valid? #f)
                    (let ((bytes (make-bytevector size)))
                      (when (fx=? comma 1) (bytevector-u8-set! bytes 0 44))
                      (bytevector-copy! encoded 0 bytes comma length)
                      (bytevector-u8-set! bytes (fx- size 1) 58)
                      (vector-set! prefixes i bytes)
                      (vector-set! ordinals i ordinal)
                      (set! i (fx+ i 1)))))))
        #f) #f)
    (and valid? (fx=? i n)
         (begin (set! template-bytes (fx+ template-bytes charge))
                (vector ordinals prefixes n)))))
(define (template-key-plan template)
  (let* ((n (pmap-cnt template)) (root (pmap-root template))
         (found (if template-cache (hashtable-ref template-cache root jolt-nil) jolt-nil)))
    (cond
      ((not (eq? found jolt-nil))
       (and found (fx=? (vector-ref found 2) n) found))
      ((and (fx<=? n 128) (fx<? template-attempts 8))
       (set! template-attempts (fx+ template-attempts 1))
       (let ((plan (compile-prefix-plan template)))
         (unless template-cache (set! template-cache (make-weak-eq-hashtable)))
         (hashtable-set! template-cache root plan)
         plan))
      (else #f))))
(define (prefix-bytes! bytes)
  (let ((n (bytevector-length bytes)))
    (when (fx>? n (fx- budget (fx+ completed used)))
      (error 'ffc-json "byte limit exceeded"))
    (let loop ((offset 0))
      (unless (fx=? offset n)
        (ensure-space!)
        (let ((take (fxmin (fx- n offset) (fx- (bytevector-length tail) used))))
          (bytevector-copy! bytes offset tail used take)
          (set! used (fx+ used take))
          (loop (fx+ offset take)))))))
(define (scalar-prefix-map! template)
  (let ((plan (template-key-plan template)))
    (if plan
        (let ((ordinals (vector-ref plan 0)) (prefixes (vector-ref plan 1)))
          (do ((i 0 (fx+ i 1))) ((fx=? i (vector-length ordinals)))
            (prefix-bytes! (vector-ref prefixes i))
            (scalar-text-value! (vector-ref ordinals i))))
        (ffc-map-fold template scalar-text-entry! #f))))
