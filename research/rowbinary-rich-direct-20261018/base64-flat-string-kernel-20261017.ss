;; Candidate for the existing b64-encode helper. Preserve input conversion,
;; alphabet and padding semantics; allocate exactly one encoded String.
(lambda (x alphabet pad?)
  (let* ((bs (->bytevector x)) (n (bytevector-length bs))
         (groups (quotient n 3)) (tail (remainder n 3))
         (length (+ (* groups 4) (if (= tail 0) 0 (if pad? 4 (+ tail 1)))))
         (out (make-string length #\=)) (complete (* groups 3)))
    (let loop ((i 0) (j 0))
      (if (< i complete)
          (let ((a (bytevector-u8-ref bs i))
                (b (bytevector-u8-ref bs (+ i 1)))
                (c (bytevector-u8-ref bs (+ i 2))))
            (string-set! out j (string-ref alphabet (bitwise-arithmetic-shift-right a 2)))
            (string-set! out (+ j 1)
              (string-ref alphabet (bitwise-ior (bitwise-arithmetic-shift-left (bitwise-and a 3) 4)
                                              (bitwise-arithmetic-shift-right b 4))))
            (string-set! out (+ j 2)
              (string-ref alphabet (bitwise-ior (bitwise-arithmetic-shift-left (bitwise-and b 15) 2)
                                              (bitwise-arithmetic-shift-right c 6))))
            (string-set! out (+ j 3) (string-ref alphabet (bitwise-and c 63)))
            (loop (+ i 3) (+ j 4)))
          (begin
            (when (> tail 0)
              (let ((a (bytevector-u8-ref bs i)))
                (string-set! out j (string-ref alphabet (bitwise-arithmetic-shift-right a 2)))
                (if (= tail 1)
                    (string-set! out (+ j 1)
                      (string-ref alphabet (bitwise-arithmetic-shift-left (bitwise-and a 3) 4)))
                    (let ((b (bytevector-u8-ref bs (+ i 1))))
                      (string-set! out (+ j 1)
                        (string-ref alphabet (bitwise-ior (bitwise-arithmetic-shift-left (bitwise-and a 3) 4)
                                                        (bitwise-arithmetic-shift-right b 4))))
                      (string-set! out (+ j 2)
                        (string-ref alphabet (bitwise-arithmetic-shift-left (bitwise-and b 15) 2)))))))
            out)))))
