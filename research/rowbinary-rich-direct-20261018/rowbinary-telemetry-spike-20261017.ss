;; Diagnostic only: closed type descriptors, built-in vectors/maps, bounded
;; invocation-owned output. No SQL, persistence, global caches or JSON hooks.
(lambda (types inputs producer maximum)
  (let ((buffer (make-bytevector (min maximum 65536))) (used 0))
    (define (ensure! n)
      (when (> (+ used n) maximum) (error 'rowbinary-spike "byte limit exceeded"))
      (when (> (+ used n) (bytevector-length buffer))
        (let ((larger (make-bytevector
                       (min maximum (max (+ used n) (* 2 (max 1 (bytevector-length buffer))))))))
          (bytevector-copy! buffer 0 larger 0 used)
          (set! buffer larger))))
    (define (u8! n)
      (ensure! 1) (bytevector-u8-set! buffer used n) (set! used (+ used 1)))
    (define (length! n)
      (let loop ((n n))
        (if (< n 128) (u8! n)
            (begin (u8! (bitwise-ior 128 (bitwise-and n 127)))
                   (loop (bitwise-arithmetic-shift-right n 7))))))
    (define (string! value)
      (unless (string? value) (error 'rowbinary-spike "String value required"))
      (let* ((bytes (string->utf8 value)) (n (bytevector-length bytes)))
        (length! n) (ensure! n)
        (bytevector-copy! bytes 0 buffer used n) (set! used (+ used n))))
    (define (compile-type descriptor)
      (case (pvec-nth! descriptor 0)
        ((0) string!)
        ((1)
         (lambda (value)
           (unless (and (integer? value) (exact? value)
                        (<= -9223372036854775808 value 9223372036854775807))
             (error 'rowbinary-spike "Int64 value required"))
           (ensure! 8) (bytevector-s64-set! buffer used value (endianness little))
           (set! used (+ used 8))))
        ((2)
         (lambda (value)
           (unless (and (integer? value) (exact? value)
                        (<= 0 value 18446744073709551615))
             (error 'rowbinary-spike "UInt64 value required"))
           (ensure! 8) (bytevector-u64-set! buffer used value (endianness little))
           (set! used (+ used 8))))
        ((3)
         (lambda (value)
           (unless (and (integer? value) (exact? value) (<= 0 value 255))
             (error 'rowbinary-spike "UInt8 value required"))
           (u8! value)))
        ((4)
         (lambda (value)
           (unless (boolean? value) (error 'rowbinary-spike "Bool value required"))
           (u8! (if value 1 0))))
        ((5)
         (let ((emit (compile-type (pvec-nth! descriptor 1))))
           (lambda (value)
             (unless (pvec? value) (error 'rowbinary-spike "Array vector required"))
             (length! (pvec-count value))
             (do ((i 0 (+ i 1))) ((= i (pvec-count value)))
               (emit (pvec-nth! value i))))))
        ((6)
         (let ((emit-key (compile-type (pvec-nth! descriptor 1)))
               (emit-value (compile-type (pvec-nth! descriptor 2))))
           (lambda (value)
             (unless (pmap? value) (error 'rowbinary-spike "Map value required"))
             (length! (pmap-cnt value))
             (pmap-fold-seq-order value
               (lambda (key value acc) (emit-key key) (emit-value value) acc) #f))))
        ((7)
         (lambda (value)
           (unless (flonum? value) (error 'rowbinary-spike "Float64 value required"))
           (ensure! 8) (bytevector-ieee-double-set! buffer used value (endianness little))
           (set! used (+ used 8))))
        (else (error 'rowbinary-spike "Unsupported descriptor"))))
    (unless (and (pvec? types) (pvec? inputs))
      (error 'rowbinary-spike "Type/input vectors required"))
    (let* ((width (pvec-count types)) (emitters (make-vector width)))
      (do ((i 0 (+ i 1))) ((= i width))
        (vector-set! emitters i (compile-type (pvec-nth! types i))))
      (do ((i 0 (+ i 1))) ((= i (pvec-count inputs)))
        (let ((row (if (jolt-nil? producer) (pvec-nth! inputs i)
                       (jolt-invoke1 producer (pvec-nth! inputs i)))))
          (unless (and (pvec? row) (= width (pvec-count row)))
            (error 'rowbinary-spike "Row width mismatch"))
          (do ((j 0 (+ j 1))) ((= j width))
            ((vector-ref emitters j) (pvec-nth! row j))))))
    (let ((result (make-bytevector used)))
      (bytevector-copy! buffer 0 result 0 used)
      (na-owned-bv->bytearray result))))
