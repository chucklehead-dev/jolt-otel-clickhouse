+++ b/src/test/jolt/clojure/data/json_default_publication_test.clj
@@ -0,0 +1,58 @@
+(ns clojure.data.json-default-publication-test
+  (:require [clojure.test :refer [deftest is run-tests]]
+            [clojure.data.json :as json]
+            [clojure.data.json.jolt-native :as native]
+            [clojure.java.io :as io]
+            [jolt.scheme :as scheme]))
+
+(native/load-payload-byte-buffer-writer!)
+
+(deftype VisibleChild [seen]
+  json/JSONWriter
+  (-write [_ out _]
+    (swap! seen conj (.toString out))
+    (.write out "7")))
+
+(deftest default-identity-check-does-not-publish-an-incomplete-map-prefix
+  (let [source (slurp (io/resource "clojure/data/json/jolt_byte_writer.ss"))
+        factory
+        (scheme/eval-string
+          (str "(let ((publications 0) (original djn-sb-install-or-append!))
+                  (let ((djn-sb-install-or-append!
+                          (lambda (writer text)
+                            (set! publications (+ publications 1))
+                            (original writer text)))) " source
+               " (jolt-vector djn-make-byte-buffer-writer
+                   (lambda () publications)
+                   (lambda () (set! publications 0)))))"))
+        writer ((nth factory 0))
+        value {"nested" (sorted-map "a" 1)}
+        write! (fn []
+                 (let [out (java.io.StringWriter.)]
+                   (writer value out json/default-write-options @#'json/native-writer-stock)
+                   (.toString out)))]
+    ;; Warm this factory's method site before observing publication counts.
+    (is (= (json/write-str value) (write!)))
+    ((nth factory 2))
+    (is (= "{\"nested\":{\"a\":1}}" (write!)))
+    ;; The sorted receiver's real classification boundary and final output
+    ;; remain; only the earlier bare-"{" omission publication disappears.
+    (is (= 2 ((nth factory 1))))))
+
+(deftest actual-custom-writer-still-observes-the-current-key-and-colon
+  (let [seen (atom []) value {"nested" (VisibleChild. seen)}]
+    (is (= "{\"nested\":7}"
+           (binding [json/*experimental-native-writer*
+                     (native/load-payload-byte-buffer-writer!)]
+             (json/write-str value))))
+    (is (= ["{\"nested\":"] @seen))
+    (reset! seen [])
+    (is (= "prefix\n{\"nested\":7}\n"
+           (String. (native/write-prefixed-batch-bytes! "prefix\n" [value] 100) "UTF-8")))
+    ;; The callback sees its own row, not the preceding payload prefix.
+    (is (= ["{\"nested\":"] @seen))))
+
+(defn -main [& _]
+  (let [r (run-tests 'clojure.data.json-default-publication-test)]
+    (assert (= 2 (:test r)))
+    (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))
