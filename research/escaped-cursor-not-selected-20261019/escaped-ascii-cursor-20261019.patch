--- /dev/null
+++ b/src/test/jolt/clojure/data/json_escape_cursor_test.clj
@@ -0,0 +1,55 @@
+(ns clojure.data.json-escape-cursor-test
+  (:require [clojure.test :refer [deftest is run-tests]]
+            [clojure.data.json :as json]
+            [clojure.data.json.jolt-native :as native]
+            [clojure.java.io :as io]
+            [clojure.string :as str]
+            [jolt.scheme :as scheme]))
+
+(native/load-payload-byte-buffer-writer!)
+
+(deftest direct-two-byte-path-has-an-output-equivalent-disabled-control
+  (let [source (slurp (io/resource "clojure/data/json/jolt_byte_writer.ss"))
+        observed (str/replace source "(#3%bytevector-u8-set! buf cursor 92)"
+                   "(begin (set! escapes (+ escapes 1)) (#3%bytevector-u8-set! buf cursor 92))")
+        disabled (str/replace observed "(fx<=? cursor 65534)" "#f")
+        probe (fn [body]
+                (let [factory (scheme/eval-string
+                                (str "(let ((escapes 0)) " body
+                                  " (jolt-vector djn-make-byte-buffer-writer (lambda () escapes)))"))
+                      out (java.io.StringWriter.)]
+                  (((nth factory 0)) "\"\\/" out json/default-write-options
+                    @#'json/native-writer-stock)
+                  [(.toString out) ((nth factory 1))]))
+        expected (json/write-str "\"\\/")]
+    ;; Keep negative-control logs scalar: do not print the whole source twice.
+    (is (true? (not= source observed)))
+    (is (true? (not= observed disabled)))
+    (is (= [expected 3] (probe observed)))
+    (is (= [expected 0] (probe disabled)))))
+
+(deftest common-escapes-retain-unicode-controls-and-exact-boundaries
+  ;; Opening quotes/array delimiters shift the cursor too. This interval
+  ;; exercises common escapes with zero, one and two scratch bytes remaining,
+  ;; followed by controls/Unicode and the closing quote across later flushes.
+  (doseq [n (concat [0 14 15 16] (range 65528 65540))
+          shape [:string :nested]]
+    (let [value (str (apply str (repeat n "a")) "\"\\/\b\f\n\r\tβ😀")
+          value (if (= shape :nested) {"key\"\\/" [value false nil]} value)
+          ordinary (binding [json/*experimental-native-writer* nil]
+                     (json/write-str value))
+          prefix "prefix/β😀\n"
+          payload (str ordinary "\n")
+          size (alength (.getBytes payload "UTF-8"))
+          bytes (native/write-prefixed-batch-bytes! prefix [value] size)]
+      (is (= (str prefix payload) (String. bytes "UTF-8")))
+      (is (= (+ size (alength (.getBytes prefix "UTF-8"))) (alength bytes)))
+      (is (= :clojure.data.json.jolt-native/output-limit
+             (:type (ex-data
+                      (try (native/write-prefixed-batch-bytes! prefix [value] (dec size))
+                        (catch clojure.lang.ExceptionInfo e e)))))))))
+
+(defn -main [& _]
+  (let [r (run-tests 'clojure.data.json-escape-cursor-test)]
+    (assert (= 2 (:test r)))
+    (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))
