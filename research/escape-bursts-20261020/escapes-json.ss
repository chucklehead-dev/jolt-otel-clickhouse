;; Explicit built-in-data JSON encoder, NOT a data.json backend/replacement.
;; Research scope: nil, booleans, strings, named values, integers, finite doubles,
;; ordinary persistent maps and stock sorted maps (string/keyword/symbol keys),
;; and vectors. No custom JSONWriter dispatch, key/value hooks or sequences yet.
;; UTF-8 output; controls/quotes/slashes are escaped, Unicode scalars are literal.
;; Fresh invocation owns all state. Only the final, independent byte[] escapes.
(define-record-type ffc-json-text (fields bytes))
;; Explicit row view: a private fixed-width native vector plus an immutable
;; persistent suffix. Neither native storage nor a mutable output alias escapes.
(define-record-type ffc-json-row (fields base suffix))
(define (ffc-json-row-box fields) (make-ffc-json-row fields empty-pvec))
(define (ffc-json-row-append row suffix)
  (unless (and (ffc-json-row? row) (pvec? suffix)
               (fx=? (pvec-count (ffc-json-row-suffix row)) 0))
    (error 'ffc-json-row "expected a row without suffix and a persistent vector"))
  (make-ffc-json-row (ffc-json-row-base row) suffix))
(define (ffc-json-row-width row)
  (unless (ffc-json-row? row) (error 'ffc-json-row "expected a row"))
  (fx+ (vector-length (ffc-json-row-base row)) (pvec-count (ffc-json-row-suffix row))))
(define-record-type ffc-fragments
  (fields (mutable table) (mutable insertions) (mutable retained)
          (mutable scratch) (mutable digits)))
(define (ffc-new-fragments)
  (make-ffc-fragments #f 0 0 (make-bytevector 1024) (make-bytevector 21)))
(define ffc-fragment-count-key (keyword #f "cnt"))
(define-syntax define-ffc-json-encoder
  (syntax-rules ()
    ((_ encode-name flat-cache?)
     (define-ffc-json-encoder encode-name flat-cache? #f () #f))
    ((_ encode-name flat-cache? shared-cache? (extra-argument ...) shared-state)
     (define (encode-name value limit max-depth lines? escape-unicode? project prefix extra-argument ...)
  (unless (and (fixnum? limit) (fx>=? limit 0)
               (fixnum? max-depth) (fx>=? max-depth 0))
    (error 'ffc-json "invalid byte/depth limit"))
  (unless (string? prefix) (error 'ffc-json "prefix must be ASCII text"))
  ;; A scope shares only ASCII nested JSON fragments, never another wire mode.
  (when shared-cache?
    (unless (and escape-unicode? (not lines?) (not project) (string=? prefix ""))
      (error 'ffc-json "invalid shared-fragment mode")))
  (do ((i 0 (fx+ i 1))) ((fx=? i (string-length prefix)))
    (unless (fx<=? (char->integer (string-ref prefix i)) 127)
      (error 'ffc-json "prefix must be ASCII text")))
  (let* ((budget (+ limit (string-length prefix)))
         (_ (unless (fixnum? budget) (error 'ffc-json "byte limit too large")))
         (tail (let ((capacity (min (if lines? 65536 1024) budget)))
                 ;; Only scratch is reused. A short budget still gets a
                 ;; clamped buffer: byte! relies on capacity to enforce it.
                 (if (and shared-cache? (fx=? capacity 1024))
                     (ffc-fragments-scratch shared-state) (make-bytevector capacity))))
        (used 0) (completed 0) (parts '()) (container-depth 0)
        (digits (if shared-cache? (ffc-fragments-digits shared-state) (make-bytevector 21)))
        ;; Per-call weak roots; only independently copied, complete fragments.
        ;; Fixed bounds: 64 insertions, 128KiB retained, <=4KiB per fragment.
        (map-cache (if shared-cache? (ffc-fragments-table shared-state) #f))
        (map-insertions (if shared-cache? (ffc-fragments-insertions shared-state) 0))
        (map-retained (if shared-cache? (ffc-fragments-retained shared-state) 0))
        (map-flat? #f))
    (define (ensure-space!)
      (when (fx=? used (bytevector-length tail))
        (when (fx>=? (fx+ completed used) budget) (error 'ffc-json "byte limit exceeded"))
        (set! completed (fx+ completed used))
        (set! parts (cons tail parts))
        (set! tail (make-bytevector
                    (min 65536 (fx* 2 (bytevector-length tail)) (fx- budget completed))))
        (set! used 0)))
    (define (byte! b)
      (ensure-space!)
      (bytevector-u8-set! tail used b)
      (set! used (fx+ used 1)))
    (define (ascii! text)
      (do ((i 0 (fx+ i 1))) ((fx=? i (string-length text)))
        (byte! (char->integer (string-ref text i)))))
    (define (pair! a b)
      ;; All callers supply private validated byte values. Capacity was clamped
      ;; to the byte budget; one guard proves BOTH writes fit. Keep the original
      ;; byte-at-a-time path at chunk/budget boundaries, including limit errors.
      (if (fx<=? 2 (fx- (bytevector-length tail) used))
          (begin
            (#3%bytevector-u8-set! tail used a)
            (#3%bytevector-u8-set! tail (fx+ used 1) b)
            (set! used (fx+ used 2)))
          (begin (byte! a) (byte! b))))
    (define (u16! cp)
      (if (fx<=? 6 (fx- (bytevector-length tail) used))
          (let ((start used))
            (#3%bytevector-u8-set! tail start 92)
            (#3%bytevector-u8-set! tail (fx+ start 1) 117)
            (let loop ((i 2) (shift 12))
              (unless (fx<? shift 0)
                (let ((n (fxand (fxsra cp shift) 15)))
                  (#3%bytevector-u8-set! tail (fx+ start i)
                    (if (fx<? n 10) (fx+ 48 n) (fx+ 87 n))))
                (loop (fx+ i 1) (fx- shift 4))))
            (set! used (fx+ start 6)))
          (begin
            (ascii! "\\u")
            (do ((shift 12 (fx- shift 4))) ((fx<? shift 0))
              (let ((n (fxand (fxsra cp shift) 15)))
                (byte! (if (fx<? n 10) (fx+ 48 n) (fx+ 87 n))))))))
    (define (escaped-char! cp)
          (cond
           ((or (fx=? cp 34) (fx=? cp 92) (fx=? cp 47)) (pair! 92 cp))
           ((fx=? cp 8) (pair! 92 98)) ((fx=? cp 12) (pair! 92 102))
           ((fx=? cp 10) (pair! 92 110)) ((fx=? cp 13) (pair! 92 114))
           ((fx=? cp 9) (pair! 92 116))
           ((and (fx>=? cp 32) (fx<=? cp 127)) (byte! cp))
           ((fx<? cp 32) (u16! cp))
           ((and (fx>=? cp #xd800) (fx<=? cp #xdfff))
            (error 'ffc-json "unpaired surrogate"))
           (escape-unicode?
            (if (fx<=? cp #xffff) (u16! cp)
                (let ((n (fx- cp #x10000)))
                  (u16! (fx+ #xd800 (fxsra n 10)))
                  (u16! (fx+ #xdc00 (fxand n #x3ff))))))
           ((fx<=? cp #x7ff)
            (byte! (fxior #xc0 (fxsra cp 6)))
            (byte! (fxior #x80 (fxand cp #x3f))))
           ((fx<=? cp #xffff)
            (byte! (fxior #xe0 (fxsra cp 12)))
            (byte! (fxior #x80 (fxand (fxsra cp 6) #x3f)))
            (byte! (fxior #x80 (fxand cp #x3f))))
           (else
            (byte! (fxior #xf0 (fxsra cp 18)))
            (byte! (fxior #x80 (fxand (fxsra cp 12) #x3f)))
            (byte! (fxior #x80 (fxand (fxsra cp 6) #x3f)))
            (byte! (fxior #x80 (fxand cp #x3f))))))
    (define (string! text)
      (byte! 34)
      ;; Keep the clean ASCII cursor local; publish once before an escape,
      ;; a chunk change, or completion. Tail capacity itself enforces budget.
      (let ((n (string-length text)))
        (let loop ((i 0) (cursor used))
          (cond
           ((fx=? i n) (set! used cursor))
           ((fx=? cursor (bytevector-length tail))
            (set! used cursor) (ensure-space!) (loop i used))
           (else
            ;; i<n and cursor<tail length above; text is a primitive String,
            ;; tail is private. Unchecked operations never accept public arrays.
            (let ((cp (char->integer (#3%string-ref text i))))
              (if (and (fx>=? cp 32) (fx<=? cp 127)
                       (not (fx=? cp 34)) (not (fx=? cp 92)) (not (fx=? cp 47)))
                  (begin (#3%bytevector-u8-set! tail cursor cp)
                         (loop (fx+ i 1) (fx+ cursor 1)))
                  (begin (set! used cursor) (escaped-char! cp)
                         (loop (fx+ i 1) used))))))))
      (byte! 34))
    ;; This is encoded ASCII JSON used as a STRING field in outer JSON, not a
    ;; raw JSON splice. Bytes come only from this backend's private encoder.
    (define (encoded-text! bytes)
      (byte! 34)
      (let ((n (bytevector-length bytes)))
        (let loop ((i 0) (cursor used))
          (cond
           ((fx=? i n) (set! used cursor))
           ((fx=? cursor (bytevector-length tail))
            (set! used cursor) (ensure-space!) (loop i used))
           (else
            (let ((cp (#3%bytevector-u8-ref bytes i)))
              (if (and (not (fx=? cp 34)) (not (fx=? cp 92)) (not (fx=? cp 47)))
                  (begin (#3%bytevector-u8-set! tail cursor cp)
                         (loop (fx+ i 1) (fx+ cursor 1)))
                  (begin (set! used cursor) (escaped-char! cp)
                         (loop (fx+ i 1) used))))))))
      (byte! 34))
    (define (integer! n)
      ;; Bignums retain a correct but allocating fallback. No false no-allocation
      ;; claim for arbitrary numeric sizes; telemetry's 64-bit range uses scratch.
      (if (not (<= -9223372036854775808 n 18446744073709551615))
          (ascii! (number->string n))
          (let ((negative? (< n 0)))
            (let loop ((n n) (i 20))
              (let* ((small? (fixnum? n))
                     (q (if small? (fxquotient n 10) (quotient n 10)))
                     (r (if small? (fxremainder n 10) (remainder n 10))))
                (bytevector-u8-set! digits i (fx+ 48 (fxabs r)))
                (if (= q 0)
                    (let ((start (if negative? (fx- i 1) i)))
                      (when negative? (bytevector-u8-set! digits start 45))
                      (do ((j start (fx+ j 1))) ((fx=? j 21))
                        (byte! (bytevector-u8-ref digits j))))
                    (loop q (fx- i 1))))))))
    (define (key! k)
      (cond ((string? k) (string! k))
            ((keyword? k) (string! (keyword-t-name k)))
            ((symbol-t? k) (string! (symbol-t-name k)))
            (else (error 'ffc-json "unsupported object key"))))
    ;; One visitor per invocation, not a closure for every nested map/vector.
    ;; Recursive emit restores the parent's depth before this visitor resumes.
    ;; No user callback receives this invocation's private mutable context.
    (define (map-entry! k v printed?)
      (when printed? (byte! 44)) (key! k) (byte! 58)
      (emit! v (fx+ container-depth 1)) #t)
    (define (tracked-map-entry! k v printed?)
      ;; Piggyback eligibility on the existing walk, never a second traversal.
      (unless (and (string? k)
                   (if shared-cache?
                       (or (string? v) (jolt-nil? v) (boolean? v)
                           (and (integer? v) (exact? v))
                           (and (flonum? v) (finite? v)))
                       (string? v)))
        (set! map-flat? #f))
      (map-entry! k v printed?))
    (define (fragment! bytes depth)
      ;; Every eligible map is nonempty and its scalar values are one level
      ;; below it. Reusing bytes must not bypass the current call's limits.
      (when (fx>=? depth max-depth) (error 'ffc-json "depth limit exceeded"))
      (let ((n (bytevector-length bytes)))
        (when (fx>? n (fx- budget (fx+ completed used)))
          (error 'ffc-json "byte limit exceeded"))
        (let loop ((offset 0))
          (unless (fx=? offset n)
            (ensure-space!)
            (let ((take (fxmin (fx- n offset) (fx- (bytevector-length tail) used))))
              (bytevector-copy! bytes offset tail used take)
              (set! used (fx+ used take))
              (loop (fx+ offset take)))))))
    (define (map! m depth)
      (let* ((candidate? (and flat-cache?
                             (if (pmap? m) (fx>=? (pmap-cnt m) 8)
                                 (and shared-cache? (ffc-stock-sorted-map? m)
                                      (fx>=? (jolt-ref-get m ffc-fragment-count-key) 8)))))
             ;; Sorted-map admission already checked the stock ops table in
             ;; emit!, including on hits. Identity is its immutable tree root.
             (root (and candidate? (if (pmap? m) (pmap-root m) (jolt-ref-get m kw-tree))))
             (cached (and root map-cache (hashtable-ref map-cache root #f))))
        (if cached (fragment! cached depth)
            (let ((previous container-depth) (previous-flat map-flat?)
                  (start-tail tail) (start used)
                  (track? (and candidate? (fx<? map-insertions 64) (fx<? map-retained 131072))))
              (set! container-depth depth)
              (set! map-flat? #t)
              (byte! 123)
              (ffc-map-fold m (if track? tracked-map-entry! map-entry!) #f)
              (byte! 125)
              ;; A map crossing chunks simply declines. Capture no partial
              ;; fragment, source map wrapper/metadata, or mutable output alias.
              (when (and track? map-flat? (eq? start-tail tail))
                (let ((charge (fx- used start)))
                  (when (and (fx<=? charge 4096) (fx<=? (fx+ map-retained charge) 131072))
                    (let ((bytes (make-bytevector charge)))
                      (bytevector-copy! tail start bytes 0 charge)
                      (unless map-cache (set! map-cache (make-weak-eq-hashtable)))
                      (hashtable-set! map-cache root bytes)
                      (set! map-insertions (fx+ map-insertions 1))
                      (set! map-retained (fx+ map-retained charge))
                      (when shared-cache?
                        (ffc-fragments-table-set! shared-state map-cache)
                        (ffc-fragments-insertions-set! shared-state map-insertions)
                        (ffc-fragments-retained-set! shared-state map-retained))))))
              (set! container-depth previous)
              (set! map-flat? previous-flat)))))
    (define (vector-entry! v printed?)
      (when printed? (byte! 44)) (emit! v (fx+ container-depth 1)) #t)
    (define (emit! x depth)
      (when (fx>? depth max-depth) (error 'ffc-json "depth limit exceeded"))
      (cond
       ((jolt-nil? x) (ascii! "null"))
       ((boolean? x) (ascii! (if x "true" "false")))
       ((string? x) (string! x))
       ((ffc-json-text? x) (encoded-text! (ffc-json-text-bytes x)))
       ((and (integer? x) (exact? x)) (integer! x))
       ((and (flonum? x) (finite? x)) (ascii! (jolt-flonum->string x)))
       ((keyword? x) (string! (keyword-t-name x)))
       ((symbol-t? x) (string! (symbol-t-name x)))
       ((ffc-json-row? x)
        (byte! 91)
        (let ((previous container-depth) (base (ffc-json-row-base x)))
          (set! container-depth depth)
          (let loop ((i 0) (printed? #f))
            (if (fx=? i (vector-length base))
                (ffc-vector-fold (ffc-json-row-suffix x) vector-entry! printed?)
                (loop (fx+ i 1) (vector-entry! (vector-ref base i) printed?))))
          (set! container-depth previous))
        (byte! 93))
       ((or (pmap? x) (ffc-stock-sorted-map? x) (ffc-stock-record? x))
        ;; Macro specialization keeps cache state/closures out of scalar and
        ;; uncached calls. Both variants share this one algorithm definition.
        (if flat-cache? (map! x depth)
            (begin
              (byte! 123)
              (let ((previous container-depth))
                (set! container-depth depth)
                (ffc-map-fold x map-entry! #f)
                (set! container-depth previous))
              (byte! 125))))
       ((pvec? x)
        (byte! 91)
        (let ((previous container-depth))
          (set! container-depth depth)
          (ffc-vector-fold x vector-entry! #f)
          (set! container-depth previous))
        (byte! 93))
       (else (error 'ffc-json "unsupported value"))))
    (ascii! prefix)
    (if lines?
        (ffc-records-fold value
          (lambda (row ignored)
            (emit! (if project (jolt-invoke1 project row) row) 0)
            (byte! 10) #f) #f)
        (emit! value 0))
    (let* ((total (fx+ completed used)) (out (make-bytevector total)))
      (let loop ((remaining (reverse parts)) (offset 0))
        (if (null? remaining)
            (bytevector-copy! tail 0 out offset used)
            (let ((part (car remaining)))
              (bytevector-copy! part 0 out offset (bytevector-length part))
              (loop (cdr remaining) (fx+ offset (bytevector-length part))))))
      ;; Stock runtime constructor, not the fork's na-owned-bv->bytearray.
      ;; out is newly allocated and no encoder alias survives this call.
      (make-jolt-array out 'byte)))))))

(define-ffc-json-encoder ffc-json-encode/plain #f)
(define-ffc-json-encoder ffc-json-encode/cached #t)
(define-ffc-json-encoder ffc-json-encode/shared #t #t (fragments) fragments)
;; Private dispatcher for mechanism tests. Public facades select a specialized
;; entry point directly, not a per-map mode switch in the disabled path.
(define (ffc-json-encode value limit max-depth lines? escape-unicode? project prefix flat-cache?)
  ((if flat-cache? ffc-json-encode/cached ffc-json-encode/plain)
   value limit max-depth lines? escape-unicode? project prefix))

(define (ffc-json-bytes value limit max-depth)
  (ffc-json-encode/plain value limit max-depth #f #f #f ""))
(define (ffc-json-lines-bytes rows limit max-depth)
  (ffc-json-encode/plain rows limit max-depth #t #f #f ""))
(define (ffc-json-ascii-bytes value limit max-depth)
  (ffc-json-encode/plain value limit max-depth #f #t #f ""))
(define (ffc-json-nested-text value limit max-depth)
  (make-ffc-json-text (jolt-array-vec (ffc-json-ascii-bytes value limit max-depth))))
(define (ffc-json-ascii-lines-bytes rows limit max-depth)
  (ffc-json-encode/plain rows limit max-depth #t #t #f ""))
(define (ffc-json-project-ascii-lines-bytes rows project limit max-depth)
  (ffc-json-encode/plain rows limit max-depth #t #t project ""))
(define (ffc-json-project-prefixed-ascii-lines-bytes prefix rows project limit max-depth)
  (ffc-json-encode/plain rows limit max-depth #t #t project prefix))
(define (ffc-json-cached-project-prefixed-ascii-lines-bytes prefix rows project limit max-depth)
  (ffc-json-encode/cached rows limit max-depth #t #t project prefix))

(define (ffc-json-nested-scope)
  (let ((fragments (ffc-new-fragments)) (active? #t))
    (jolt-vector
     (lambda (value limit max-depth)
       (unless active? (error 'ffc-json "nested-text scope is closed"))
       (if (and (pvec? value) (fx=? (pvec-count value) 0)) "[]"
           (make-ffc-json-text
            (jolt-array-vec
             (ffc-json-encode/shared value limit max-depth #f #t #f "" fragments)))))
     (lambda ()
       (set! active? #f)
       (ffc-fragments-table-set! fragments #f)
       (ffc-fragments-insertions-set! fragments 0)
       (ffc-fragments-retained-set! fragments 0)
       (ffc-fragments-scratch-set! fragments #f)
       (ffc-fragments-digits-set! fragments #f)))))
