;; Research only: exporter policy stays in its live owner Vars/callbacks.
;; No global helper registration, native mutable buffer or input mutation.
;; Snapshot roots are supplied by the trusted research harness before controls;
;; a production owner would need defining-namespace original root anchors.
(let ((timestamp-var (jolt-var "otel.exporter.chdb" "timestamp"))
      (state-var (jolt-var "otel.exporter.chdb" "trace-state-string"))
      (enum-var (jolt-var "otel.exporter.chdb" "otel-enum-string"))
      (service-var (jolt-var "otel.exporter.chdb" "service-name"))
      (events-var (jolt-var "otel.exporter.chdb" "event-columns"))
      (links-var (jolt-var "otel.exporter.chdb" "link-columns"))
      (minus-var (jolt-var "clojure.core" "-"))
      (max-var (jolt-var "clojure.core" "max"))
      (context-key (keyword #f "span-context")) (scope-key (keyword #f "scope"))
      (resource-key (keyword #f "resource")) (events-key (keyword #f "events"))
      (links-key (keyword #f "links")) (start-key (keyword #f "start-time-unix-nano"))
      (end-key (keyword #f "end-time-unix-nano")) (trace-key (keyword #f "trace-id"))
      (span-key (keyword #f "span-id")) (parent-key (keyword #f "parent-span-id"))
      (state-key (keyword #f "trace-state")) (name-key (keyword #f "name"))
      (kind-key (keyword #f "kind")) (internal-key (keyword #f "internal"))
      (attributes-key (keyword #f "attributes")) (version-key (keyword #f "version"))
      (status-key (keyword #f "status")) (code-key (keyword #f "code"))
      (unset-key (keyword #f "unset")) (description-key (keyword #f "description"))
      (event-time-key (keyword #f "timestamp-unix-nano")))
  (define (default value fallback) (if (jolt-truthy? value) value fallback))
  (define (singleton value) (make-pvec (vector value)))
  (lambda (build-row append-fields original-events original-links)
    (lambda (convert nested typed)
      (define (event-columns events)
        (cond
          ((and (eq? (var-cell-deref events-var) original-events) (pvec? events)
                (fx=? (pvec-count events) 0))
           (values empty-pvec empty-pvec empty-pvec))
          ((and (eq? (var-cell-deref events-var) original-events) (pvec? events)
                (fx=? (pvec-count events) 1))
           ;; Match time -> name -> attributes evaluation and callback order.
           (let* ((event (pvec-nth! events 0))
                  (times (singleton (jolt-invoke1 (var-cell-deref timestamp-var)
                                               (jolt-get event event-time-key))))
                  (names (singleton (default (jolt-get event name-key) "")))
                  (attributes (singleton (jolt-invoke1 convert (jolt-get event attributes-key)))))
             (values times names attributes)))
          (else
           (let ((columns (jolt-invoke3 (var-cell-deref events-var) events #t convert)))
             (values (jolt-nth columns 0 jolt-nil) (jolt-nth columns 1 jolt-nil)
                     (jolt-nth columns 2 jolt-nil))))))
      (define (link-columns links)
        (if (and (eq? (var-cell-deref links-var) original-links) (pvec? links)
                 (fx=? (pvec-count links) 0))
            (values empty-pvec empty-pvec empty-pvec empty-pvec)
            (let ((columns (jolt-invoke3 (var-cell-deref links-var) links #t convert)))
              (values (jolt-nth columns 0 jolt-nil) (jolt-nth columns 1 jolt-nil)
                      (jolt-nth columns 2 jolt-nil) (jolt-nth columns 3 jolt-nil)))))
      (lambda (span)
        (let* ((context (jolt-get span context-key)) (scope (jolt-get span scope-key))
               (resource (jolt-get span resource-key))
               (events (default (jolt-get span events-key) empty-pvec))
               (links (default (jolt-get span links-key) empty-pvec))
               (time (jolt-invoke1 (var-cell-deref timestamp-var) (jolt-get span start-key)))
               (trace-id (default (jolt-get context trace-key) ""))
               (span-id (default (jolt-get context span-key) ""))
               (parent-id (default (jolt-get span parent-key) ""))
               (trace-state (jolt-invoke1 (var-cell-deref state-var) (jolt-get context state-key)))
               (name (jolt-get span name-key))
               (kind (jolt-invoke2 (var-cell-deref enum-var) (jolt-get span kind-key) internal-key))
               (service (jolt-invoke2 (var-cell-deref service-var) resource "unknown_service:jolt"))
               (resource-attrs (jolt-invoke1 convert (jolt-get resource attributes-key)))
               (scope-name (default (jolt-get scope name-key) ""))
               (scope-version (default (jolt-get scope version-key) ""))
               (span-attrs (jolt-invoke1 convert (jolt-get span attributes-key)))
               (duration (jolt-invoke2 (var-cell-deref max-var) 0
                           (jolt-invoke2 (var-cell-deref minus-var)
                             (jolt-get span end-key) (jolt-get span start-key))))
               (status (jolt-invoke2 (var-cell-deref enum-var)
                         (jolt-get (jolt-get span status-key) code-key) unset-key))
               (message (default (jolt-get (jolt-get span status-key) description-key) ""))
               (events-json (jolt-invoke1 nested events))
               (links-json (jolt-invoke1 nested links)))
          (let*-values (((event-times event-names event-attrs) (event-columns events))
                        ((link-traces link-spans link-states link-attrs) (link-columns links)))
            ;; One native base, not a compact persistent row and `into` copy.
            ;; Typed projection still happens AFTER all ordinary preparation.
            (let* ((base (build-row time trace-id span-id parent-id trace-state name kind
                           service resource-attrs scope-name scope-version span-attrs
                           duration status message event-times event-names event-attrs
                           link-traces link-spans link-states link-attrs events-json links-json))
                   (suffix (jolt-invoke1 typed span)))
              (append-fields base suffix))))))))
