;; Diagnostic only. Live exporter helpers, normal row-vector output, no codec.
;; Not installed into the exporter. Core lookup/numeric behavior is trusted;
;; arbitrary clojure.core redefinition is not qualified by this experiment.
(lambda (keys helpers duration)
  (define (k n) (pvec-nth! keys n))
  (define (call1 n x) (jolt-invoke1 (var-cell-deref (pvec-nth! helpers n)) x))
  (define (call2 n x y) (jolt-invoke2 (var-cell-deref (pvec-nth! helpers n)) x y))
  (define (or-empty x) (if (jolt-truthy? x) x ""))
  (define (or-vector x) (if (jolt-truthy? x) x empty-pvec))
  (lambda (span)
    (let* ((context (jolt-get span (k 0)))
           (scope (jolt-get span (k 1)))
           (resource (jolt-get span (k 2)))
           (events (or-vector (jolt-get span (k 3))))
           (links (or-vector (jolt-get span (k 4))))
           (time (call1 0 (jolt-get span (k 5))))
           (trace-id (or-empty (jolt-get context (k 6))))
           (span-id (or-empty (jolt-get context (k 7))))
           (parent-id (or-empty (jolt-get span (k 8))))
           (trace-state (call1 1 (jolt-get context (k 9))))
           (span-name (jolt-get span (k 10)))
           (kind (call2 2 (jolt-get span (k 11)) (k 12)))
           (service (call2 3 resource "unknown_service:jolt"))
           (resource-attrs (call1 4 (jolt-get resource (k 13))))
           (scope-name (or-empty (jolt-get scope (k 10))))
           (scope-version (or-empty (jolt-get scope (k 14))))
           (span-attrs (call1 4 (jolt-get span (k 13))))
           (elapsed (jolt-invoke1 duration span))
           (status (call2 2 (jolt-get (jolt-get span (k 15)) (k 16)) (k 17)))
           (message (or-empty (jolt-get (jolt-get span (k 15)) (k 18))))
           (events-json (call1 5 events))
           (links-json (call1 5 links))
           (event-values (call2 6 events #t))
           (link-values (call2 7 links #t)))
      (make-pvec
        (vector time trace-id span-id parent-id trace-state span-name kind service
                resource-attrs scope-name scope-version span-attrs elapsed status message
                (jolt-nth event-values 0) (jolt-nth event-values 1) (jolt-nth event-values 2)
                (jolt-nth link-values 0) (jolt-nth link-values 1)
                (jolt-nth link-values 2) (jolt-nth link-values 3)
                events-json links-json)))))
