;; Diagnostic: all-primitive string-key maps, no converter callback during fast
;; conversion. Unsupported maps/policies use the unchanged transform.
(lambda (clone baseline key-var value-var original-key original-value policy-var original-policy)
  (define (pure-node? node maximum)
    (and (hnode? node)
      (let ((arr (hnode-arr node)))
        (let loop ((i 0))
          (or (= i (vector-length arr))
              (let ((child (vector-ref arr i)))
                (and (if (hnode? child) (pure-node? child maximum)
                         (and (pair? child) (string? (car child))
                              (let ((v (cdr child)))
                                (or (boolean? v) (fixnum? v)
                                    (and (string? v) (<= (string-length v) maximum))))))
                     (loop (+ i 1)))))))))
  (define (same-roots?)
    (and (eq? (var-cell-deref key-var) original-key)
         (eq? (var-cell-deref value-var) original-value)
         (eq? (var-cell-deref policy-var) original-policy)))
  (lambda (m)
    (let ((maximum (and (same-roots?) (jolt-invoke0 original-policy))))
      (if (and (jolt-truthy? maximum) (pmap? m)
               (> (pmap-cnt m) 8) (<= (pmap-cnt m) 128)
               (pure-node? (pmap-root m) maximum) (same-roots?))
          (clone m key-var
            (lambda (v)
              (cond ((string? v) v) ((eq? v #t) "true") ((eq? v #f) "false")
                    (else (jolt-fixnum->string v))))
            original-key)
          (jolt-invoke1 baseline m)))))
