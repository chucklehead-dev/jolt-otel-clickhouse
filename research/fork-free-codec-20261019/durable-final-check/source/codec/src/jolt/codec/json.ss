;; Explicit built-in-data JSON encoder, NOT a data.json backend/replacement.
;; Research scope: nil, booleans, strings, named values, integers, finite doubles,
;; ordinary persistent maps and stock sorted maps (string/keyword/symbol keys),
;; and vectors. No custom JSONWriter dispatch, key/value hooks or sequences yet.
;; UTF-8 output; controls/quotes/slashes are escaped, Unicode scalars are literal.
;; Fresh invocation owns all state. Only the final, independent byte[] escapes.
(define (ffc-json-encode value limit max-depth lines? escape-unicode? project prefix)
  (unless (and (fixnum? limit) (fx>=? limit 0)
               (fixnum? max-depth) (fx>=? max-depth 0))
    (error 'ffc-json "invalid byte/depth limit"))
  (unless (string? prefix) (error 'ffc-json "prefix must be ASCII text"))
  (do ((i 0 (fx+ i 1))) ((fx=? i (string-length prefix)))
    (unless (fx<=? (char->integer (string-ref prefix i)) 127)
      (error 'ffc-json "prefix must be ASCII text")))
  (let* ((budget (+ limit (string-length prefix)))
         (_ (unless (fixnum? budget) (error 'ffc-json "byte limit too large")))
         (tail (make-bytevector (min (if lines? 65536 1024) budget)))
        (used 0) (completed 0) (parts '()) (container-depth 0)
        (digits (make-bytevector 21)))
    (define (ensure-space!)
      (when (fx=? used (bytevector-length tail))
        (when (fx>=? (fx+ completed used) budget) (error 'ffc-json "byte limit exceeded"))
        (set! completed (fx+ completed used))
        (set! parts (cons tail parts))
        (set! tail (make-bytevector
                    (min 65536 (fx* 2 (bytevector-length tail)) (fx- budget completed))))
        (set! used 0)))
    (define (byte! b)
      (ensure-space!)
      (bytevector-u8-set! tail used b)
      (set! used (fx+ used 1)))
    (define (ascii! text)
      (do ((i 0 (fx+ i 1))) ((fx=? i (string-length text)))
        (byte! (char->integer (string-ref text i)))))
    (define (u16! cp)
      (ascii! "\\u")
      (do ((shift 12 (fx- shift 4))) ((fx<? shift 0))
        (let ((n (fxand (fxsra cp shift) 15)))
          (byte! (if (fx<? n 10) (fx+ 48 n) (fx+ 87 n))))))
    (define (escaped-char! cp)
          (cond
           ((or (fx=? cp 34) (fx=? cp 92) (fx=? cp 47)) (byte! 92) (byte! cp))
           ((fx=? cp 8) (ascii! "\\b")) ((fx=? cp 12) (ascii! "\\f"))
           ((fx=? cp 10) (ascii! "\\n")) ((fx=? cp 13) (ascii! "\\r"))
           ((fx=? cp 9) (ascii! "\\t"))
           ((and (fx>=? cp 32) (fx<=? cp 127)) (byte! cp))
           ((fx<? cp 32) (u16! cp))
           ((and (fx>=? cp #xd800) (fx<=? cp #xdfff))
            (error 'ffc-json "unpaired surrogate"))
           (escape-unicode?
            (if (fx<=? cp #xffff) (u16! cp)
                (let ((n (fx- cp #x10000)))
                  (u16! (fx+ #xd800 (fxsra n 10)))
                  (u16! (fx+ #xdc00 (fxand n #x3ff))))))
           ((fx<=? cp #x7ff)
            (byte! (fxior #xc0 (fxsra cp 6)))
            (byte! (fxior #x80 (fxand cp #x3f))))
           ((fx<=? cp #xffff)
            (byte! (fxior #xe0 (fxsra cp 12)))
            (byte! (fxior #x80 (fxand (fxsra cp 6) #x3f)))
            (byte! (fxior #x80 (fxand cp #x3f))))
           (else
            (byte! (fxior #xf0 (fxsra cp 18)))
            (byte! (fxior #x80 (fxand (fxsra cp 12) #x3f)))
            (byte! (fxior #x80 (fxand (fxsra cp 6) #x3f)))
            (byte! (fxior #x80 (fxand cp #x3f))))))
    (define (string! text)
      (byte! 34)
      ;; Keep the clean ASCII cursor local; publish once before an escape,
      ;; a chunk change, or completion. Tail capacity itself enforces budget.
      (let ((n (string-length text)))
        (let loop ((i 0) (cursor used))
          (cond
           ((fx=? i n) (set! used cursor))
           ((fx=? cursor (bytevector-length tail))
            (set! used cursor) (ensure-space!) (loop i used))
           (else
            ;; i<n and cursor<tail length above; text is a primitive String,
            ;; tail is private. Unchecked operations never accept public arrays.
            (let ((cp (char->integer (#3%string-ref text i))))
              (if (and (fx>=? cp 32) (fx<=? cp 127)
                       (not (fx=? cp 34)) (not (fx=? cp 92)) (not (fx=? cp 47)))
                  (begin (#3%bytevector-u8-set! tail cursor cp)
                         (loop (fx+ i 1) (fx+ cursor 1)))
                  (begin (set! used cursor) (escaped-char! cp)
                         (loop (fx+ i 1) used))))))))
      (byte! 34))
    (define (integer! n)
      ;; Bignums retain a correct but allocating fallback. No false no-allocation
      ;; claim for arbitrary numeric sizes; telemetry's 64-bit range uses scratch.
      (if (not (<= -9223372036854775808 n 18446744073709551615))
          (ascii! (number->string n))
          (let ((negative? (< n 0)))
            (let loop ((n n) (i 20))
              (let* ((small? (fixnum? n))
                     (q (if small? (fxquotient n 10) (quotient n 10)))
                     (r (if small? (fxremainder n 10) (remainder n 10))))
                (bytevector-u8-set! digits i (fx+ 48 (fxabs r)))
                (if (= q 0)
                    (let ((start (if negative? (fx- i 1) i)))
                      (when negative? (bytevector-u8-set! digits start 45))
                      (do ((j start (fx+ j 1))) ((fx=? j 21))
                        (byte! (bytevector-u8-ref digits j))))
                    (loop q (fx- i 1))))))))
    (define (key! k)
      (cond ((string? k) (string! k))
            ((keyword? k) (string! (keyword-t-name k)))
            ((symbol-t? k) (string! (symbol-t-name k)))
            (else (error 'ffc-json "unsupported object key"))))
    ;; One visitor per invocation, not a closure for every nested map/vector.
    ;; Recursive emit restores the parent's depth before this visitor resumes.
    ;; No user callback receives this invocation's private mutable context.
    (define (map-entry! k v printed?)
      (when printed? (byte! 44)) (key! k) (byte! 58)
      (emit! v (fx+ container-depth 1)) #t)
    (define (vector-entry! v printed?)
      (when printed? (byte! 44)) (emit! v (fx+ container-depth 1)) #t)
    (define (emit! x depth)
      (when (fx>? depth max-depth) (error 'ffc-json "depth limit exceeded"))
      (cond
       ((jolt-nil? x) (ascii! "null"))
       ((boolean? x) (ascii! (if x "true" "false")))
       ((string? x) (string! x))
       ((and (integer? x) (exact? x)) (integer! x))
       ((and (flonum? x) (finite? x)) (ascii! (jolt-flonum->string x)))
       ((keyword? x) (string! (keyword-t-name x)))
       ((symbol-t? x) (string! (symbol-t-name x)))
       ((or (pmap? x) (ffc-stock-sorted-map? x))
        (byte! 123)
        (let ((previous container-depth))
          (set! container-depth depth)
          (ffc-map-fold x map-entry! #f)
          (set! container-depth previous))
        (byte! 125))
       ((pvec? x)
        (byte! 91)
        (let ((previous container-depth))
          (set! container-depth depth)
          (ffc-vector-fold x vector-entry! #f)
          (set! container-depth previous))
        (byte! 93))
       (else (error 'ffc-json "unsupported value"))))
    (ascii! prefix)
    (if lines?
        (ffc-records-fold value
          (lambda (row ignored)
            (emit! (if project (jolt-invoke1 project row) row) 0)
            (byte! 10) #f) #f)
        (emit! value 0))
    (let* ((total (fx+ completed used)) (out (make-bytevector total)))
      (let loop ((remaining (reverse parts)) (offset 0))
        (if (null? remaining)
            (bytevector-copy! tail 0 out offset used)
            (let ((part (car remaining)))
              (bytevector-copy! part 0 out offset (bytevector-length part))
              (loop (cdr remaining) (fx+ offset (bytevector-length part))))))
      ;; Stock runtime constructor, not the fork's na-owned-bv->bytearray.
      ;; out is newly allocated and no encoder alias survives this call.
      (make-jolt-array out 'byte))))

(define (ffc-json-bytes value limit max-depth)
  (ffc-json-encode value limit max-depth #f #f #f ""))
(define (ffc-json-lines-bytes rows limit max-depth)
  (ffc-json-encode rows limit max-depth #t #f #f ""))
(define (ffc-json-ascii-bytes value limit max-depth)
  (ffc-json-encode value limit max-depth #f #t #f ""))
(define (ffc-json-ascii-lines-bytes rows limit max-depth)
  (ffc-json-encode rows limit max-depth #t #t #f ""))
(define (ffc-json-project-ascii-lines-bytes rows project limit max-depth)
  (ffc-json-encode rows limit max-depth #t #t project ""))
(define (ffc-json-project-prefixed-ascii-lines-bytes prefix rows project limit max-depth)
  (ffc-json-encode rows limit max-depth #t #t project prefix))
